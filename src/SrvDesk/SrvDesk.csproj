<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>SrvDesk</AssemblyName>
    <RootNamespace>SrvDesk</RootNamespace>
    <Title>Windows server优化助手SrvDesk</Title>
    <Product>Windows server优化助手SrvDesk</Product>
    <Company>SrvDesk</Company>
    <Authors>SrvDesk</Authors>
    <Copyright>Copyright (c) 2026 gygy</Copyright>
    <Description>Windows Server 与桌面系统设置优化工具</Description>
    <Version>1.0.56</Version>
    <FileVersion>1.0.56.0</FileVersion>
    <InformationalVersion>1.0.56</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <NeutralLanguage>zh-CN</NeutralLanguage>
    <DebugType Condition="'$(Configuration)'=='Release'">pdbonly</DebugType>
    <DebugSymbols Condition="'$(Configuration)'=='Release'">true</DebugSymbols>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>false</GenerateBindingRedirectsOutputType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Management" />
    <Reference Include="System.DirectoryServices" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="SrvDesk.app.ico" />
    <EmbeddedResource Include="app.png" LogicalName="SrvDesk.app.png" />
    <EmbeddedResource Include="..\..\LICENSE" Link="Legal\LICENSE" LogicalName="SrvDesk.LICENSE" />
    <EmbeddedResource Include="..\..\DISCLAIMER.md" Link="Legal\DISCLAIMER.md" LogicalName="SrvDesk.DISCLAIMER.md" />
    <EmbeddedResource Include="..\..\PRIVACY.md" Link="Legal\PRIVACY.md" LogicalName="SrvDesk.PRIVACY.md" />
  </ItemGroup>
  <!-- 本地若杀软秒删 Intermediate exe，可临时注释本 Target；交付仍走 scripts/publish.ps1 -->
  <Target Name="CopyExeToDist" AfterTargets="CoreCompile" Condition="'$(SkipCopyExeToDist)'!='true'">
    <PropertyGroup>
      <_CopyDistScript>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\scripts\copy-to-dist.ps1'))</_CopyDistScript>
      <_CopyDistSource Condition="Exists('$(IntermediateOutputPath)$(TargetFileName)')">$(IntermediateOutputPath)$(TargetFileName)</_CopyDistSource>
      <_CopyDistSource Condition="'$(_CopyDistSource)'=='' And Exists('$(TargetPath)')">$(TargetPath)</_CopyDistSource>
    </PropertyGroup>
    <Exec Condition="'$(_CopyDistSource)'!='' And Exists('$(_CopyDistScript)')"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(_CopyDistScript)&quot; -SourceExe &quot;$(_CopyDistSource)&quot;"
          IgnoreExitCode="true"
          ContinueOnError="true" />
  </Target>
  <Target Name="RemoveAppConfigAfterBuild" AfterTargets="Build">
    <Delete Files="$(TargetPath).config" Condition="Exists('$(TargetPath).config')" />
  </Target>
  <Target Name="RemoveAppConfigAfterPublish" AfterTargets="Publish">
    <ItemGroup>
      <_ConfigFiles Include="$(PublishDir)**\$(AssemblyName).exe.config" />
    </ItemGroup>
    <Delete Files="@(_ConfigFiles)" />
  </Target>
</Project>
