<?xml version='1.0'?>
<!--
  轻度混淆（低误报优先）：
  - 重命名类型/方法/字段/属性/事件
  - 不加密字符串、不做控制流混淆（降低杀软误报）
  - 跳过 JSON/配置反射依赖的类型，避免导入导出与偏好文件失效
-->
<Obfuscator>
  <Var name="InPath" value="./in" />
  <Var name="OutPath" value="./out" />
  <Var name="KeepPublicApi" value="false" />
  <Var name="HidePrivateApi" value="true" />
  <Var name="RenameProperties" value="true" />
  <Var name="RenameEvents" value="true" />
  <Var name="RenameFields" value="true" />
  <Var name="UseUnicodeNames" value="false" />
  <Var name="UseKoreanNames" value="false" />
  <Var name="HideStrings" value="false" />
  <Var name="OptimizeMethods" value="true" />
  <Var name="SuppressIldasm" value="true" />
  <Var name="RegenerateDebugInfo" value="false" />

  <!-- publish.ps1 会替换为本机 .NET Framework 目录，供解析 WinForms 等依赖 -->
  <AssemblySearchPath path="./framework" />

  <Module file="$(InPath)\SrvDesk.exe">
    <!-- 配置 JSON：DataContract 成员名 -->
    <SkipType name="SrvDesk.UiPrefsData" skipProperties="true" skipFields="true" skipMethods="true" />
    <SkipType name="SrvDesk.ServerProfileData" skipProperties="true" skipFields="true" skipMethods="true" />
    <SkipType name="SrvDesk.OptimizationHistoryFile" skipProperties="true" skipFields="true" skipMethods="true" />
    <SkipType name="SrvDesk.OptimizationHistoryEntry" skipProperties="true" skipFields="true" skipMethods="true" />
    <SkipType name="SrvDesk.OptProfileFile" skipProperties="true" skipFields="true" skipMethods="true" />
    <SkipType name="SrvDesk.SettingEntry" skipProperties="true" skipFields="true" skipMethods="true" />
    <SkipType name="SrvDesk.SettingScriptStore/StoreFile" skipProperties="true" skipFields="true" skipMethods="true" />
    <!-- 我的方案：稳定 JSON 字段名（禁止属性重命名） -->
    <SkipType name="SrvDesk.UserPlanIndex" skipProperties="true" skipFields="true" skipMethods="true" />
    <SkipType name="SrvDesk.UserPlanSummary" skipProperties="true" skipFields="true" skipMethods="true" />
    <SkipType name="SrvDesk.UserPlanDetail" skipProperties="true" skipFields="true" skipMethods="true" />
    <SkipType name="SrvDesk.UserPlanItem" skipProperties="true" skipFields="true" skipMethods="true" />
    <SkipType name="SrvDesk.UserPlanExportFile" skipProperties="true" skipFields="true" skipMethods="true" />
    <SkipType name="SrvDesk.UserPlanLegacyObfDetail" skipProperties="true" skipFields="true" skipMethods="true" />
    <SkipType name="SrvDesk.UserPlanLegacyObfItem" skipProperties="true" skipFields="true" skipMethods="true" />
    <!-- 自定义配置方案 JSON -->
    <SkipType name="SrvDesk.CustomPackIndex" skipProperties="true" skipFields="true" skipMethods="true" />
    <SkipType name="SrvDesk.CustomPackSummary" skipProperties="true" skipFields="true" skipMethods="true" />
    <SkipType name="SrvDesk.CustomPackDetail" skipProperties="true" skipFields="true" skipMethods="true" />
    <SkipType name="SrvDesk.CustomPackItem" skipProperties="true" skipFields="true" skipMethods="true" />
    <SkipType name="SrvDesk.CustomPackExport" skipProperties="true" skipFields="true" skipMethods="true" />
    <SkipType name="SrvDesk.CustomPackItemExport" skipProperties="true" skipFields="true" skipMethods="true" />

    <!-- 预设/导入导出：反射 Optimizer.State 公共字段名 -->
    <SkipType name="SrvDesk.Optimizer/State" skipProperties="true" skipFields="true" skipMethods="true" />
    <!-- 导入预览：用 Catalog 字段名对齐 State 键 → 侧栏栏目/分区/项目名 -->
    <SkipType name="SrvDesk.SettingCatalog" skipProperties="true" skipFields="true" skipMethods="true" />
  </Module>
</Obfuscator>
